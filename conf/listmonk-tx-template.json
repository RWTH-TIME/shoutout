{
  "name": "shoutout",
  "type": "tx",
  "subject": "{{ if eq .Tx.Data.kind \"failed\" }}Transcription failed{{ else }}Transcription ready{{ end }}: {{ .Tx.Data.jobName }}",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>shoutout</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f3f4f6\">\n<tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px;background:#ffffff;border-radius:12px;border:1px solid #e5e7eb\">\n<tr><td style=\"padding:28px 32px 8px 32px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n<td style=\"vertical-align:middle\"><img src=\"data:image/svg+xml;base64,\" alt=\"shoutout\" width=\"40\" height=\"40\" style=\"display:block;border:0;border-radius:8px\"></td>\n<td style=\"vertical-align:middle;padding-left:12px;font-size:18px;font-weight:700\">shoutout</td>\n</tr></table>\n</td></tr>\n<tr><td style=\"padding:16px 32px 0 32px\">\n{{ if eq .Tx.Data.kind \"failed\" }}\n<h1 style=\"margin:0 0 8px 0;font-size:20px;color:#b91c1c\">Transcription failed</h1>\n<p style=\"margin:0 0 12px 0;font-size:15px;line-height:1.5\">Transcription of <strong>{{ .Tx.Data.jobName }}</strong> ({{ .Tx.Data.model }}) failed.</p>\n{{ if .Tx.Data.error }}<p style=\"margin:0 0 12px 0;padding:12px;background:#fef2f2;border-radius:8px;font-size:13px;color:#991b1b\">{{ .Tx.Data.error }}</p>{{ end }}\n{{ else }}\n<h1 style=\"margin:0 0 8px 0;font-size:20px\">Your transcript is ready</h1>\n<p style=\"margin:0 0 12px 0;font-size:15px;line-height:1.5\"><strong>{{ .Tx.Data.jobName }}</strong> ({{ .Tx.Data.model }}) has finished.</p>\n{{ end }}\n</td></tr>\n<tr><td style=\"padding:8px 32px 8px 32px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n<td style=\"padding:0 8px 8px 0\"><a href=\"{{ .Tx.Data.jobUrl }}\" style=\"display:inline-block;padding:10px 18px;border-radius:8px;border:1px solid #d1d5db;color:#111827;font-size:14px;font-weight:600;text-decoration:none\">Open job</a></td>\n{{ if .Tx.Data.downloadUrl }}<td style=\"padding:0 8px 8px 0\"><a href=\"{{ .Tx.Data.downloadUrl }}\" style=\"display:inline-block;padding:10px 18px;border-radius:8px;background:#3b82f6;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none\">Download transcript (ZIP)</a></td>{{ end }}\n</tr></table>\n</td></tr>\n{{ range .Tx.Data.files }}\n<tr><td style=\"padding:8px 32px 8px 32px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border:1px solid #e5e7eb;border-radius:10px\">\n<tr><td style=\"padding:16px 16px 4px 16px\">\n<div style=\"font-size:15px;font-weight:700;word-break:break-all\">{{ .name }}</div>\n{{ if .duration }}<div style=\"font-size:12px;color:#6b7280;margin-top:2px\">Duration {{ .duration }}</div>{{ end }}\n</td></tr>\n{{ if .stats }}\n<tr><td style=\"padding:12px 16px 4px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n<td width=\"33%\" style=\"padding:8px;background:#f9fafb;border-radius:8px\"><div style=\"font-size:11px;color:#6b7280;text-transform:uppercase\">Speakers</div><div style=\"font-size:18px;font-weight:700\">{{ .stats.speakerCount }}</div></td>\n<td width=\"4\"></td>\n<td width=\"33%\" style=\"padding:8px;background:#f9fafb;border-radius:8px\"><div style=\"font-size:11px;color:#6b7280;text-transform:uppercase\">Words</div><div style=\"font-size:18px;font-weight:700\">{{ .stats.totalWords }}</div></td>\n<td width=\"4\"></td>\n<td width=\"33%\" style=\"padding:8px;background:#f9fafb;border-radius:8px\"><div style=\"font-size:11px;color:#6b7280;text-transform:uppercase\">Characters</div><div style=\"font-size:18px;font-weight:700\">{{ .stats.totalChars }}</div></td>\n</tr></table>\n</td></tr>\n<tr><td style=\"padding:8px 16px 4px 16px\">\n{{ range .stats.speakers }}\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:8px\"><tr>\n<td style=\"font-size:13px\"><span style=\"display:inline-block;width:8px;height:8px;border-radius:4px;background:{{ .color }}\"></span>&nbsp;{{ .name }}</td>\n<td align=\"right\" style=\"font-size:12px;color:#6b7280\">{{ .words }} words &middot; {{ .percentage }}%</td>\n</tr></table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:4px;background:#f3f4f6;border-radius:3px\"><tr>\n{{ if .percentage }}<td width=\"{{ .percentage }}%\" height=\"6\" bgcolor=\"{{ .color }}\" style=\"font-size:0;line-height:0;border-radius:3px\">&nbsp;</td>{{ end }}\n<td height=\"6\" style=\"font-size:0;line-height:0\">&nbsp;</td>\n</tr></table>\n{{ end }}\n</td></tr>\n{{ end }}\n{{ if .pdfUrl }}\n<tr><td style=\"padding:12px 16px 16px 16px\">\n<a href=\"{{ .pdfUrl }}\" style=\"display:inline-block;padding:10px 18px;border-radius:8px;background:#111827;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none\">Download PDF</a>\n</td></tr>\n{{ end }}\n</table>\n</td></tr>\n{{ end }}\n<tr><td style=\"padding:16px 32px 28px 32px;font-size:12px;color:#9ca3af\">made with <a href=\"https://github.com/RWTH-TIME/shoutout\" style=\"color:#9ca3af\">shoutout</a></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>\n"
}
