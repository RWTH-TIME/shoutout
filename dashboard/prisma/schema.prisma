generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model job {
  id            Int            @id @default(autoincrement())
  publicId      String         @unique @default(uuid()) @db.Uuid
  owner         String         @db.Uuid
  name          String         @unique
  audioFile     String?
  participants  Int?
  language      String?
  model         String
  notifyEmail   String?
  notifyEnabled Boolean        @default(true)
  visibility    Visibility     @default(PRIVATE)
  expiresAt     DateTime?
  status        Status         @default(PENDING)
  workerId      String?
  claimedAt     DateTime?
  heartbeatAt   DateTime?
  error         String?
  attempts      Int            @default(0)
  claimCount    Int            @default(0)
  resultToken   String?        @unique
  resultZipKey  String?
  onBehalfOf    String?
  createdAt     DateTime       @default(now())
  worker        worker?        @relation(fields: [workerId], references: [id])
  files         jobFile[]
  notifications notification[]
  usage         usageEvent?

  @@index([owner, createdAt])
  @@index([status, createdAt])
  @@index([status, model])
  @@index([expiresAt])
}

model jobFile {
  id              String  @id @default(uuid()) @db.Uuid
  jobId           Int
  position        Int
  originalName    String
  audioFile       String
  participants    Int?
  language        String?
  resultTextKey   String?
  resultJsonKey   String?
  durationSeconds Float?
  speakerNames    Json?
  job             job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model notification {
  id        String             @id @default(uuid()) @db.Uuid
  // One row per job, event and claim; the unique key stops duplicate mails.
  dedupeKey String             @unique
  jobId     Int?
  kind      String
  status    NotificationStatus
  recipient String?
  error     String?
  createdAt DateTime           @default(now())
  job       job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([jobId])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model userSettings {
  owner          String  @id @db.Uuid
  notifyEmail    String?
  notifyOnFinish Boolean @default(true)
  notifyOnFail   Boolean @default(false)
}

model worker {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  tokenHash  String
  lastSeenAt DateTime @default(now())
  models     String[]
  info       Json?
  jobs       job[]
}

model serviceAccount {
  id        String       @id @db.Uuid
  name      String       @unique
  createdAt DateTime     @default(now())
  apiKeys   apiKey[]
  usage     usageEvent[]
}

model usageEvent {
  id               String         @id @default(uuid()) @db.Uuid
  serviceAccountId String         @db.Uuid
  jobId            Int            @unique
  onBehalfOf       String?
  audioSeconds     Float          @default(0)
  files            Int            @default(0)
  createdAt        DateTime       @default(now())
  serviceAccount   serviceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  job              job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([serviceAccountId, createdAt])
}

model apiKey {
  id               String          @id @default(uuid()) @db.Uuid
  owner            String          @db.Uuid
  name             String
  prefix           String
  hash             String          @unique
  ownerEmail       String?
  serviceAccountId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  serviceAccount   serviceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([owner])
  @@index([serviceAccountId])
}

enum Status {
  PENDING
  FINISHED
  FAILED
  RUNNING
  CANCELLED
  RECORDING
}

enum Visibility {
  PRIVATE
  AUTHENTICATED
  PUBLIC
}
